<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Casper.DataForge.CrossPlatform.MainWindow"
    Title="Casper.DataForge"
    Icon="/Assets/Casper.DataForge.png"
    Width="1500"
    Height="850"
    MinWidth="1100"
    MinHeight="650"
    Background="#0D1016">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E8EAF0"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#252A34"/>
      <Setter Property="Foreground" Value="#F4F6FA"/>
      <Setter Property="BorderBrush" Value="#3B4352"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2C69A8"/>
      <Setter Property="BorderBrush" Value="#4384C5"/>
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#12161E"/>
      <Setter Property="BorderBrush" Value="#2B3340"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="TextBox.editor">
      <Setter Property="Background" Value="#171A21"/>
      <Setter Property="Foreground" Value="#E8EAF0"/>
      <Setter Property="BorderBrush" Value="#343B48"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="SelectionBrush" Value="#365F91"/>
      <Setter Property="FontFamily" Value="Consolas, Inter"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="TextBox.query">
      <Setter Property="Background" Value="#171A21"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#3C4657"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#9FA8B8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="2,0,0,7"/>
    </Style>

    <Style Selector="TextBlock.metric">
      <Setter Property="Foreground" Value="#8FBCE8"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="ListBox.chat">
      <Setter Property="Background" Value="#0F131B"/>
      <Setter Property="BorderBrush" Value="#343B48"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
  </Window.Styles>

  <Grid Margin="16" RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto"
          Margin="0,0,0,12">

      <StackPanel>
        <TextBlock
            Text="Casper.DataForge"
            FontSize="23"
            FontWeight="SemiBold"/>

        <TextBlock
            Text="Deterministic text structuring · Evidence graph"
            Foreground="#8491A5"
            FontSize="12"
            Margin="1,2,0,0"/>

        <TextBlock
            Text="LOCAL-FIRST KNOWLEDGE WORKBENCH / مساحة معرفة محلية"
            Foreground="#66758A"
            FontSize="10"
            Margin="1,5,0,0"/>
      </StackPanel>

      <StackPanel
          Grid.Column="1"
          Orientation="Horizontal"
          VerticalAlignment="Center">

        <Button Content="Auto" Click="AutoDirection_Click"/>
        <Button Content="RTL" Click="RtlDirection_Click"/>
        <Button Content="LTR" Click="LtrDirection_Click"/>
        <Button Content="JSON" Click="Json_Click"/>
        <Button Content="JSONL" Click="Jsonl_Click"/>
        <Button Content="Graph" Click="Graph_Click"/>
        <Button Content="Knowledge" Click="Knowledge_Click"/>
        <Button Content="History" Click="History_Click"/>
        <Button Content="Copy" Click="Copy_Click"/>
        <Button Content="Save" Click="Save_Click"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1"
          ColumnDefinitions="1.05*,6,1.05*,6,0.9*">

      <Border Grid.Column="0" Classes="panel">
        <Grid RowDefinitions="Auto,*">
          <TextBlock
              Grid.Row="0"
              Classes="label"
              Text="SOURCE / المصدر"/>

          <TextBox
              x:Name="InputTextBox"
              Grid.Row="1"
              Classes="editor"
              AcceptsReturn="True"
              AcceptsTab="True"
              TextWrapping="Wrap"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              TextChanged="InputTextBox_TextChanged"/>
        </Grid>
      </Border>

      <GridSplitter
          Grid.Column="1"
          Width="6"
          HorizontalAlignment="Stretch"
          Background="#252A34"/>

      <Border Grid.Column="2" Classes="panel">
        <Grid RowDefinitions="Auto,*">
          <TextBlock
              Grid.Row="0"
              Classes="label"
              Text="JSON / JSONL"/>

          <TextBox
              x:Name="OutputTextBox"
              Grid.Row="1"
              Classes="editor"
              IsReadOnly="True"
              AcceptsReturn="True"
              TextWrapping="NoWrap"
              FlowDirection="LeftToRight"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>
      </Border>

      <GridSplitter
          Grid.Column="3"
          Width="6"
          HorizontalAlignment="Stretch"
          Background="#252A34"/>

      <Border Grid.Column="4" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto,150">

          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto"
                Margin="0,0,0,8">

            <StackPanel>
              <TextBlock
                  Text="CASPER ENGINE / محرك كاسبر"
                  Foreground="#E8EAF0"
                  FontWeight="SemiBold"/>

              <TextBlock
                  x:Name="EngineStatusText"
                  Classes="metric"
                  Text="Checking engine..."/>

              <TextBlock
                  x:Name="DatabaseStatusText"
                  Classes="metric"
                  Text="Checking local database..."/>

              <TextBlock
                  x:Name="KnowledgeStatusText"
                  Classes="metric"
                  Text="Checking knowledge base..."/>
            </StackPanel>

            <Border
                Grid.Column="1"
                Background="#172A20"
                BorderBrush="#2F6B48"
                BorderThickness="1"
                CornerRadius="10"
                Padding="9,4">

              <TextBlock
                  x:Name="EngineBadgeText"
                  Text="UNKNOWN"
                  Foreground="#7FCEA0"
                  FontSize="11"/>
            </Border>
          </Grid>

          <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto"
                Margin="0,0,0,10">

            <TextBox
                x:Name="QueryTextBox"
                Grid.Column="0"
                Classes="query"
                Watermark="Ask Casper / اسأل كاسبر"/>

            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Classes="primary"
                Content="Send"
                Click="SendQuery_Click"/>
          </Grid>

          <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <TextBlock
                Grid.Row="0"
                Classes="label"
                Text="CHAT / المحادثة"/>

            <ListBox
                x:Name="ChatMessagesList"
                Grid.Row="1"
                Classes="chat"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          </Grid>

          <Grid Grid.Row="3"
                ColumnDefinitions="*,*"
                Margin="0,10,0,7">

            <TextBlock
                x:Name="ConfidenceText"
                Grid.Column="0"
                Classes="metric"
                Text="Confidence: -"/>

            <TextBlock
                x:Name="ProofText"
                Grid.Column="1"
                Classes="metric"
                Text="Proof: -"
                TextAlignment="Right"/>
          </Grid>

          <TextBox
              x:Name="SourcesTextBox"
              Grid.Row="4"
              Classes="editor"
              IsReadOnly="True"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              FlowDirection="LeftToRight"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              Watermark="Sources"/>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2"
          ColumnDefinitions="*,Auto"
          Margin="2,10,2,0">

      <TextBlock
          x:Name="StatusText"
          Foreground="#8F9BAD"
          Text="Ready"/>

      <TextBlock
          Grid.Column="1"
          Foreground="#66758A"
          Text="LOCAL UI · SQLITE · C ENGINE · JSON PROTOCOL"/>
    </Grid>
  </Grid>
</Window>
