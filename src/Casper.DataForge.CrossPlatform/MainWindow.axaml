<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Casper.DataForge.CrossPlatform.MainWindow" Title="Casper.DataForge" Icon="/Assets/Casper.DataForge.png" Width="1240" Height="720" MinWidth="900" MinHeight="560" Background="#111318">
<Window.Styles><Style Selector="TextBlock"><Setter Property="Foreground" Value="#E8EAF0"/></Style><Style Selector="Button"><Setter Property="Background" Value="#252A34"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="BorderBrush" Value="#3B4352"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="4,0,0,0"/></Style><Style Selector="TextBox.editor"><Setter Property="Background" Value="#171A21"/><Setter Property="Foreground" Value="#E8EAF0"/><Setter Property="BorderBrush" Value="#343B48"/><Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="SelectionBrush" Value="#365F91"/><Setter Property="FontFamily" Value="Consolas, Inter"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="12"/></Style></Window.Styles>
<Grid Margin="16" RowDefinitions="Auto,*,Auto"><Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10"><TextBlock Text="Casper.DataForge" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Auto" Click="AutoDirection_Click"/><Button Content="RTL" Click="RtlDirection_Click"/><Button Content="LTR" Click="LtrDirection_Click"/><Button Content="JSON" Click="Json_Click"/><Button Content="JSONL" Click="Jsonl_Click"/><Button Content="Copy" Click="Copy_Click"/><Button Content="Save" Click="Save_Click"/></StackPanel></Grid>
<Grid Grid.Row="1" ColumnDefinitions="*,6,*" RowDefinitions="Auto,*"><TextBlock Grid.Row="0" Grid.Column="0" Text="SOURCE / المصدر" Foreground="#9FA8B8" Margin="2,0,0,6"/><TextBlock Grid.Row="0" Grid.Column="2" Text="JSON / JSONL" Foreground="#9FA8B8" Margin="2,0,0,6"/><TextBox x:Name="InputTextBox" Classes="editor" Grid.Row="1" Grid.Column="0" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextChanged="InputTextBox_TextChanged"/><GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#252A34"/><TextBox x:Name="OutputTextBox" Classes="editor" Grid.Row="1" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FlowDirection="LeftToRight" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></Grid><TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,10,0,0" Foreground="#8F9BAD" Text="Ready"/></Grid></Window>

